{
  "name": "dsh-engine-switch",
  "version": "0.2.1",
  "description": "One phone-friendly gateway to switch DeepSeek Harness between local, desktop and server engines.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/",
    "locale/",
    "icon.svg",
    "test/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "remote",
    "gateway",
    "mobile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benson-Cao/dsh-engine-switch.git"
  },
  "bugs": {
    "url": "https://github.com/Benson-Cao/dsh-engine-switch/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/registry.js && node --check src/gateway.js && node --check test/smoke.mjs && node --check test/client.mjs",
    "test": "node test/smoke.mjs && node test/client.mjs"
  }
}
